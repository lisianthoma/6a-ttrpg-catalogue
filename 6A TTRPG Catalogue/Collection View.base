filters:
  or:
    - file.inFolder("Core Systems")
    - file.inFolder("Add-ons")
    - file.inFolder("Uncertain")
views:
  - type: cards
    name: Core Systems
    filters:
      and:
        - file.inFolder("Core Systems")
    order:
      - file.name
      - gm type
      - playercount
      - setting
      - primary features
    sort: []
    image: note.displayimage
    cardSize: 200
    imageAspectRatio: 0.8
  - type: cards
    name: Add-ons
    filters:
      and:
        - file.inFolder("Add-ons")
    order:
      - file.name
      - tags
    sort: []
    image: note.displayimage
    imageAspectRatio: 0.8
  - type: cards
    name: All
    imageAspectRatio: 0.8
    image: note.displayimage
  - type: cards
    name: Add-ons (Official Only)
    filters:
      and:
        - file.inFolder("Add-ons")
        - file.hasTag("official")
    order:
      - file.name
      - tags
    sort: []
    image: note.displayimage
    imageAspectRatio: 0.8
  - type: cards
    name: Add-ons (Homebrew Only)
    filters:
      and:
        - file.inFolder("Add-ons")
        - file.hasTag("homebrew")
    order:
      - file.name
      - tags
    sort: []
    image: note.displayimage
    imageAspectRatio: 0.8
